# ~/.config/yi/mail.conf —— yi-mail 的 IMAP 账户
#
# 总线地址与令牌不在这里,由 `yi-mail init` 写入 ~/.config/yi/bus.conf。
# 本文件权限建议 0600。密码使用 IMAP 授权码/应用专用密码,不要用登录密码。
#
# tls: implicit(993) | starttls(143) | none(仅本地测试)
# tls_verify: 自签证书或本地测试时才关掉
# folders: 逗号分隔,默认 INBOX
# source: 事件来源,默认账户名

#[account:work]
#host = imap.example.com
#port = 993
#tls = implicit
#tls_verify = true
#user = user@example.com
#password = 授权码或应用专用密码
#source = work
#folders = INBOX
